# ==============================================================================
# SmartQMA — Environment Configuration Example (.env.example)
# Nu introduceti secrete reale in acest fisier!
# ==============================================================================

# Server & Mediu
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000

# Baza de Date (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartqma_db
DB_USER=smartqma_user
DB_PASSWORD=your_secure_db_password
DB_SSL=false

# Cache & Mesagerie (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Autentificare Exclusiva Google OAuth2 / OIDC
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# JWT & Securitate Sesiune
JWT_SECRET=your_jwt_secret_minimum_32_characters_random
JWT_EXPIRATION=8h

# Setari Audit & Calitate
AUDIT_LOG_ENABLED=true
AUTO_QUARANTINE_ON_FAIL=true
