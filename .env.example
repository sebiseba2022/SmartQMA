# ==============================================================================
# SmartQMA — Configurare Mediu (.env.example)
# Stack: Laravel 11 + React + PostgreSQL 16
# ==============================================================================

APP_NAME=SmartQMA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Baza de Date PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=smartqma_db
DB_USERNAME=sebiseba2026
DB_PASSWORD=6944901aA

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=sync
CACHE_STORE=file

# Redis (Cache & Real-time)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Autentificare Exclusiva Google OAuth2 / OIDC (Laravel Socialite)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Reguli de Calitate & Trasabilitate SmartQMA
AUDIT_LOG_ENABLED=true
AUTO_QUARANTINE_ON_FAIL=true

# Setari Client Frontend (React + Vite)
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api/v1"
